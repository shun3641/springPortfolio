	@GetMapping("/application")
	public String application(Model model,
			@ModelAttribute("duplication") String duplication,
			@ModelAttribute Items items,
			@ModelAttribute(bindingResult) BindingResult bindingResults,
			@ModelAttribute("validItem") Items validItem,
			@ModelAttribute("ExistItem") Items ExistItem,
			@ModelAttribute("imageuploadmessage") String imageuploadmessage,
			@ModelAttribute("imagefileName") String imagefileName) {
		  model.addAttribute("imageuploadmessage", imageuploadmessage);
		  model.addAttribute("duplication", duplication);
		  model.addAttribute(bindingResult, bindingResults);
		  model.addAttribute("validItem",validItem);
		  validItem.setImageurl(imagefileName);
		  
		  //itemidのmax値+1をフォームで受け取る
		  CriteriaBuilder cb = entityManager.getCriteriaBuilder();
	        CriteriaQuery<Integer> query = cb.createQuery(Integer.class);
	        Root<Items> root = query.from(Items.class);
	        query.select(cb.max(root.get("itemid")));
	        Integer maxItemid = entityManager.createQuery(query).getSingleResult();
	        validItem.setItemid(maxItemid+1);
		  
	        if(ExistItem.getId()!=null) {		
			  ExistItem.setName(validItem.getName());
			  ExistItem.setPrice(validItem.getPrice());
			  ExistItem.setQuantity(validItem.getQuantity());
			  ExistItem.setDescription(validItem.getDescription());
			  ExistItem.setInfo(validItem.getInfo());
			  ExistItem.setImageurl(validItem.getImageurl());
			  System.out.println("下記の商品を更新しました。" + ExistItem);
			  itemRepository.save(ExistItem);		 
		  }
		  model.addAttribute("items",itemService.showItemAll());

		  return "admin/application";
	}
