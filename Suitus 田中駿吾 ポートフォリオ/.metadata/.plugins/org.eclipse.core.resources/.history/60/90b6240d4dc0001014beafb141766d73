<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>ユーザー登録フォーム</title>
</head>
  <!-- Bootstrap CSS link -->
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<body>
    <h2>ユーザー登録</h2>
    <div class="d-flex justify-content-center align-items-center">
    <div class="text-left">
    <form th:action="@{/user/register}" th:object="${user}" method="post" style="width: 300px; margin: 0 auto">
        <div class="form-group">
        <label for="username">ユーザー名:</label>
        <input type="text" id="username" th:field="*{username}" class="form-control"/>
		</div>
		<div class="form-group">
        <label for="email">メールアドレス:</label>
        <input type="email" id="email" th:field="*{email}" class="form-control"/>
		</div>
		<div class="form-group">
        <label for="password">パスワード:</label>
        <input type="password" id="password" th:field="*{password}" class="form-control"/>
		</div>
        <button type="submit" class="btn btn-primary">登録</button>
    <pre class="mt-3" th:text="${error}" style="font-size: 16px;color: red;overflow: visible;"></pre>
    </form>
    <a th:href="/" class="btn btn-secondary mt-3">戻る</a>
    </div>
    </div>
    
    
</body>
</html>